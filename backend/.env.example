# ─── Embedding Configuration ──────────────────────────────────────────────────
# HuggingFace model for generating document embeddings (runs locally on CPU)
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
CHUNK_SIZE=512
CHUNK_OVERLAP=100

# ─── LLM Configuration ────────────────────────────────────────────────────────
# GGUF model filename (must be placed in the models/ directory)
MODEL_FILENAME=Meta-Llama-3.1-8B-Instruct-Q4_K_M.gguf
# Context window size (tokens the model can see at once)
N_CTX=4096
# Maximum tokens to generate per response
MAX_TOKENS=256
# Sampling parameters
LLM_TEMPERATURE=0.1
LLM_TOP_K=40
LLM_TOP_P=0.95
LLM_REPEAT_PENALTY=1.1

# ─── Whisper (Speech-to-Text) ─────────────────────────────────────────────────
# Model size: "tiny", "base", "small", "medium", "large-v2"
# Smaller = faster but less accurate. "base" is a good balance for CPU.
WHISPER_MODEL_SIZE=base

# ─── TTS (Text-to-Speech) ─────────────────────────────────────────────────────
# Speech rate (words per minute, default ~200)
TTS_RATE=175
# Volume level (0.0 to 1.0)
TTS_VOLUME=0.9

# ─── Server ────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed CORS origins
CORS_ORIGINS=http://localhost:5173
# Maximum upload file size in megabytes
MAX_UPLOAD_SIZE_MB=50
# Maximum browser audio upload size in megabytes
MAX_AUDIO_SIZE_MB=25
# Maximum transcript length passed into retrieval and prompting
MAX_TRANSCRIPT_CHARS=4000
# Maximum generated prompt size, including retrieved context
MAX_PROMPT_CHARS=12000
